{
  "name": "paseo-auto-compact-for-claude",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Schedule compaction of large idle Claude conversations in Paseo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babo-jeonguk/paseo-auto-compact-for-claude.git"
  },
  "homepage": "https://github.com/babo-jeonguk/paseo-auto-compact-for-claude#readme",
  "bugs": {
    "url": "https://github.com/babo-jeonguk/paseo-auto-compact-for-claude/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 . && echo ESLint found no problems",
    "test": "node --import ./tests/support/loader.mjs --test --test-isolation=none --test-timeout=60000 server/*.test.ts scripts/*.test.ts tests/*.test.mjs",
    "check": "npm run check:observer && npm run typecheck && npm test",
    "prepack": "npm run build:observer && npm run check",
    "build:observer": "node scripts/build-observer.mjs",
    "check:observer": "node scripts/build-observer.mjs --check",
    "test:simulation": "node --no-maglev tests/simulation/matrix.mjs",
    "test:e2e": "node --no-maglev tests/e2e/run.mjs",
    "test:e2e:desktop": "node --no-maglev tests/e2e/desktop.mjs",
    "test:e2e:android": "node --no-maglev tests/e2e/android.mjs",
    "test:update": "npm run check",
    "test:focused": "node --import ./tests/support/loader.mjs --test --test-isolation=none --test-timeout=60000",
    "test:snapshot": "node scripts/test-snapshot.mjs",
    "test:release": "node scripts/test-snapshot.mjs --suite release",
    "test:simulation:0.16.2": "node --no-maglev tests/simulation/run.mjs --paseo 0.16.2",
    "test:simulation:0.17-beta": "node --no-maglev tests/simulation/run.mjs --paseo 0.17.0-beta.1",
    "test:simulation:0.17": "node --no-maglev tests/simulation/run.mjs --paseo 0.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@getpaseo/client": "0.16.2",
    "@getpaseo/plugin": "0.16.2",
    "@getpaseo/protocol": "0.16.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.4.3"
  },
  "files": [
    "paseo-plugin.json",
    "assets",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "scripts",
    "README.md",
    "OVERVIEW.md",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.test.ts",
    "!scripts/*paseo-release.ts",
    "!tests"
  ]
}
